# Скопируй этот файл в .env и заполни значения

# Токен от @BotFather
BOT_TOKEN=123456789:PUT-YOUR-TOKEN-HERE

# Владелец бота — главный (и обычно единственный) админ.
# Узнать ID: команда /myid в боте.
OWNER_ID=123456789

# Доп. администраторы-сотрудники через запятую. Обычно пусто.
ADMIN_IDS=

# Файл базы данных
DB_PATH=loyalty.db

# Индивидуальный код аккаунта: префикс + случайные буквы/цифры.
# Пример при ACCOUNT_CODE_PREFIX=TT и ACCOUNT_CODE_LENGTH=6  ->  TTA7K3QF
ACCOUNT_CODE_PREFIX=TT
ACCOUNT_CODE_LENGTH=6

# Стартовые параметры лояльности (потом меняются в боте: Админ-панель → Настройки)
DEFAULT_ACCRUAL_PERCENT=10
DEFAULT_POINT_RATE=1
DEFAULT_MIN_REDEEM=1
DEFAULT_MAX_REDEEM_SHARE=50
DEFAULT_SIGNUP_BONUS=1000
